// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  pin       String   @unique
  role      String   @default("shisha_man") // shisha_man | admin
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model InventoryItem {
  id                String   @id @default(cuid())
  brandId           String   @unique
  brandName         String
  stockGrams        Float
  lowStockThreshold Float    @default(100)
  updatedAt         DateTime @updatedAt
}

// Consumable supplies (coal, foil, …). Tracked in their own unit, auto-deducted on order.
model SupplyItem {
  id                String   @id @default(cuid())
  key               String   @unique // regular_coal | cubed_coal | foil | ...
  name              String
  unit              String   // pcs | sheets | ...
  stock             Float
  lowStockThreshold Float    @default(20)
  emoji             String   @default("📦")
  updatedAt         DateTime @updatedAt
}

model ServiceRequest {
  id              String   @id @default(cuid())
  type            String   @default("call_shisha_man") // call_shisha_man | coal_request | ...
  guestName       String?
  table           String?
  note            String?
  status          String   @default("pending") // pending | acknowledged | done
  createdAt       DateTime @default(now())
  acknowledgedAt  DateTime?
}

// A guest's saved favorite mix (their go-to bowl).
model FavoriteMix {
  id          String   @id @default(cuid())
  guestName   String
  label       String
  componentsJson String // serialized FlavorComponent[]
  createdAt   DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  customerName  String?
  phone         String?
  table         String?
  notes         String?
  itemsJson     String
  subtotal      Float
  discount      Float    @default(0)
  total         Float
  bogo          Boolean  @default(false)
  ownType       String?
  itemCount     Int      @default(0)
  status        String   @default("pending") // pending | preparing | done
  source        String   @default("employee") // employee | guest_scan | guest_call
  orderedByName String?
  employeeId    String?
  favoriteMixId String?
  createdAt     DateTime @default(now())

  comments OrderComment[]
}

model OrderComment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  author    String
  body      String
  createdAt DateTime @default(now())
}
