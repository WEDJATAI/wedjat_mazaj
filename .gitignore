# ─────────────────────────────────────────────────────────────────
# WEDJAT MAZAJ — .gitignore (r75 reorganization)
# The repo carries the PRODUCT only. Sandbox tooling, session
# evidence and derived artifacts stay local (never committed).
# ─────────────────────────────────────────────────────────────────

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/coverage
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit (secrets live here)
.env
.env*
!.env.example

# vercel
.vercel

# secrets & local data (never commit)
db/custom.db
db/backups/
upload/
backups/
.prisma-neon/

# derived local-only Prisma schema (sqlite) — generated by scripts/gen-local-schema.mjs
prisma/schema.local.prisma

# ── sandbox / environment tooling — local only, not part of the product ──
/skills/
/download/
/tests/
/examples/
.claude
.z-ai-config
local-*
prompt
tool-results/
.zscripts/dev.log
.zscripts/dev.out
.zscripts/dev.pid
.zscripts/mini-service-*.log
dev.log
dev.out.log
server.log
diag-dev.log
verify-dev.log
verify*.sh
diag*.sh
guest-check.sh

# test runners
test-results/
playwright-report/
