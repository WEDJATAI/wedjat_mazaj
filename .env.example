# ─── Mazaj Hookah Platform — Environment Variables ───────────────────
# Copy this file to `.env` and fill in your credentials.
# NEVER commit the real `.env` file.

# Primary database (Neon PostgreSQL with connection pooling)
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/dbname?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# ─── Wedjat RSM integration (HTTPS API — orders land on table checks,
# catalog + availability mirror the shisha menu). NEVER write to the
# restaurant's Turso database directly: it is a one-way mirror that gets
# wiped on every sync — the API is the only sanctioned path.
# LOCAL DEV/E2E: the mock POS (bun run dev inside mini-services/mock-rsm,
# port 3021) implements the exact webhook/catalog/inventory/status contract.
WEDJAT_RSM_URL=http://localhost:3021
WEDJAT_RSM_KEY=test-rsm-key
# PRODUCTION (set in Vercel, never here): the real restaurant POS
#   WEDJAT_RSM_URL=https://wedjatrsm-tonsy.vercel.app
#   WEDJAT_RSM_KEY=<the deliveryWebhookKey from RSM's Integrations page>

# Inngest (background jobs)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Vercel deployment protection
WEDJAT_MAZAJ_VERCEL_TOKEN=your_vercel_token

# Cron entry-point bearer (r73 backups; e2e expects dev-e2e-cron-secret locally)
CRON_SECRET=dev-e2e-cron-secret
