# ─── Mazaj Hookah Platform — Environment Variables ───────────────────
# Copy this file to `.env` and fill in your credentials.
# NEVER commit the real `.env` file.

# Primary database (Neon PostgreSQL with connection pooling)
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/dbname?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Wedjat RSM integration (HTTPS API — orders land on table checks, catalog
# + availability mirror the shisha menu). NEVER write to the restaurant's
# Turso database directly: it is a one-way mirror that gets wiped on every
# sync — the API is the only sanctioned path.
WEDJAT_RSM_URL=https://wedjatrsm-tonsy.vercel.app
WEDJAT_RSM_KEY=your_rsm_integration_key

# Inngest (background jobs)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Vercel deployment protection
WEDJAT_MAZAJ_VERCEL_TOKEN=your_vercel_token
