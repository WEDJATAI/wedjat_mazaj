// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PRODUCTION PROVIDER — this file is the single source of truth and is
  // deployed to Vercel, where DATABASE_URL points at Neon PostgreSQL.
  //
  // DO NOT flip this to "sqlite": a sqlite-generated client rejects the
  // postgres:// URL and takes the whole production site down (this exact
  // regression shipped between r57 and r59 and took wmazaj.vercel.app
  // offline — see worklog r60).
  //
  // Local sandbox dev runs against a SQLite file instead. The dev/db
  // scripts derive `prisma/schema.local.prisma` (gitignored, sqlite
  // provider) from THIS file automatically — never edit or commit that
  // derived file.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── r57 multi-tenant platform ───────────────────────────────────────────
// A Venue is a café/restaurant/hookah-lounge onboarded onto the Mazaj
// platform by the platform super admin. A Venue owns one or more Branches;
// every operational record (orders, stock, requests, staff) is scoped to a
// Branch, while venue admins can aggregate across all of them.
model Venue {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  slug      String   @unique
  kind      String   @default("hookah") // hookah | cafe | restaurant
  status    String   @default("active") // pending | active | suspended
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name       String
  nameAr     String?
  slug       String   @unique
  address    String?
  phone      String?
  isFlagship Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  employees Employee[]
  inventory InventoryItem[]
  supplies  SupplyItem[]
  orders    Order[]
  requests  ServiceRequest[]
  favorites FavoriteMix[]
  purchases Purchase[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  pin         String   @unique
  // r57 roles: platform_admin (the platform owner console) |
  // super_admin | venue_admin (multi-branch owner of one venue) |
  // admin | employee
  role        String   @default("employee")
  // Comma-separated permission keys (see src/lib/permissions.ts).
  // Empty/null => use role defaults.
  permissions String   @default("")
  active      Boolean  @default(true)
  // Multi-tenant scope: platform_admin has no venue; venue_admin/super_admin
  // may float across their venue's branches (branchId = null);
  // a branch employee is pinned to one branch.
  venueId     String?
  branchId    String?
  createdAt   DateTime @default(now())

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions EmployeeSession[]
}

// r70 — server-side staff sessions. The PIN login mints an httpOnly cookie
// (mazaj_session) holding a random 32-byte token; only its SHA-256 hash is
// stored. Privileged API routes derive the caller from this session instead
// of trusting a client-supplied employeeId (which anyone could spoof).
model EmployeeSession {
  // sha256(token) hex — the raw token lives ONLY in the cookie
  id         String   @id
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  // 30-day sliding window: every authenticated call refreshes it
  expiresAt DateTime
  ip        String?
  userAgent String?
}

model InventoryItem {
  id                String   @id @default(cuid())
  brandId           String
  brandName         String
  stockGrams        Float
  lowStockThreshold Float    @default(100)
  // r57: stock is per-BRANCH (each branch keeps its own jars)
  branchId          String?
  updatedAt         DateTime @updatedAt

  branch  Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  flavors FlavorStock[]

  @@unique([branchId, brandId])
}

// Per-flavor stock subtype (exact grams of each flavor within a brand).
model FlavorStock {
  id                String        @id @default(cuid())
  brand             InventoryItem @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String
  brandIdRaw        String // catalog brandId (e.g. "mazaya") for lookups
  brandName         String
  flavorName        String
  stockGrams        Float
  lowStockThreshold Float         @default(60)
  updatedAt         DateTime      @updatedAt

  @@unique([brandId, flavorName])
}

// Consumable supplies (coal, foil, hose, …). Tracked in their own unit, auto-deducted on order.
model SupplyItem {
  id                String   @id @default(cuid())
  key               String // regular_coal | cubed_coal | foil | medical_hose | ...
  name              String
  unit              String // pcs | sheets | ...
  stock             Float
  lowStockThreshold Float    @default(20)
  cost              Float    @default(0) // EGP per unit (business cost)
  sellPrice         Float    @default(0) // EGP charged to client when chosen as add-on
  emoji             String   @default("📦")
  // r57: supplies are per-BRANCH
  branchId          String?
  updatedAt         DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
}

model ServiceRequest {
  id             String    @id @default(cuid())
  type           String    @default("call_shisha_man") // call_shisha_man | coal_request | ...
  guestName      String?
  table          String?
  note           String?
  status         String    @default("pending") // pending | acknowledged | done
  // r57: the branch this call belongs to
  branchId       String?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// A guest's saved favorite mix (their go-to bowl).
model FavoriteMix {
  id             String   @id @default(cuid())
  guestName      String
  label          String
  componentsJson String // serialized FlavorComponent[]
  createdAt      DateTime @default(now())
  branch         Branch?  @relation(fields: [branchId], references: [id])
  branchId       String?
}

model Order {
  id               String    @id @default(cuid())
  customerName     String?
  phone            String?
  table            String?
  notes            String?
  itemsJson        String
  subtotal         Float
  discount         Float     @default(0)
  total            Float
  bogo             Boolean   @default(false)
  ownType          String?
  itemCount        Int       @default(0)
  status           String    @default("pending") // pending | preparing | done
  source           String    @default("employee") // employee | guest_scan | guest_call
  // r57: the branch that received (and stock-deducted) this order
  branchId         String?
  // R49 loyalty: the member this order earned/redeemed points for, and the
  // discount applied from redeemed points (server-validated, never trusted
  // from the client).
  loyaltyMemberId  String?
  pointsEarned     Int       @default(0)
  pointsRedeemed   Int       @default(0)
  loyaltyDiscount  Float     @default(0)
  // R49 guest feedback: 1–5 stars + optional comment, submitted by the
  // guest from the live tracking view once the order is done.
  rating           Int?
  ratingComment    String?
  ratedAt          DateTime?
  orderedByName    String?
  employeeId       String?
  favoriteMixId    String?
  // Order-receiving workflow:
  //  - "unassigned": guest self-order awaiting an employee to confirm
  //  - "assigned":   an employee has claimed/confirmed it (assignedToName set)
  //  - null:        employee-created orders are immediately theirs
  assignment       String? // unassigned | assigned
  assignedToName   String?
  assignedToId     String?
  // Profitability (computed server-side at order time)
  cogs             Float     @default(0) // cost of goods sold (molasses + supplies)
  molassesCost     Float     @default(0)
  suppliesCost     Float     @default(0)
  netProfit        Float     @default(0) // total - cogs
  marginPct        Float     @default(0) // netProfit / total * 100
  // R46: sellable add-ons chosen with the order (JSON string array, e.g.
  // ["medical_hose"]) — needed to re-push the exact check lines on retry.
  addonsJson       String?
  // r58 "Living Orders": an order stays editable (amendable) until it is
  // served. Every amendment bumps `revision`, restamps `amendedAt`,
  // records who edited it, re-adjusts branch inventory to the net delta
  // and writes a human-readable diff into the order's comment thread.
  revision         Int       @default(0)
  amendedAt        DateTime?
  amendedByName    String?
  // Wedjat RSM sync tracking
  wedjatOrderId    Int? // the order ID in Wedjat RSM (null = not synced)
  wedjatSyncStatus String    @default("pending") // pending | synced | failed | revoked
  wedjatRevokedBy  String? // name of the Wedjat employee who revoked it
  wedjatRevokedAt  DateTime?
  // R46: the NUMERIC Wedjat RSM table id (table NAMES repeat across the
  // restaurant's floors, so the id is the only unambiguous reference).
  // Captured from the POS "Order Shisha" button URL (?tableId=) or the
  // employee table picker, stored on the order and echoed to the RSM
  // webhook so items land on the RIGHT table's check.
  wedjatTableId    Int?
  // r74: the RSM floor the guest said they are sitting on ("In Door داخلي" /
  // "Out Door خارجي") — captured at guest check-in when their table number
  // exists on several floors; persisted so retries/audit know how the
  // numeric tableId was resolved.
  wedjatFloor      String?
  // r74: the last Wedjat RSM push error (why an order is "failed" — table
  // label not in the RSM floor plan, auth, RSM down…). Cleared on success.
  wedjatSyncError  String?
  createdAt        DateTime  @default(now())

  branch   Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  comments OrderComment[]
}

// r74 — mirror of the Wedjat RSM restaurant floor plan (tables + floors),
// refreshed from RSM's key-authenticated status feed every 15 minutes by
// the availability-mirror Inngest job. This is what lets Mazaj resolve a
// guest-typed table NUMBER to the numeric RSM table id (the only
// unambiguous reference for the delivery webhook) and tell the guest app
// when a table number is ambiguous across floors (indoor vs outdoor "5").
model WedjatTable {
  id        Int      @id // the NUMERIC RSM table id — the push reference
  name      String // the table's display name ("5") — what guests type
  floorName String // "In Door داخلي" | "Out Door خارجي" | …
  status    String @default("free") // free | occupied | …
  active    Boolean @default(true)
  syncedAt  DateTime @default(now())

  @@index([name])
  @@index([floorName])
}

model OrderComment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  author    String
  body      String
  createdAt DateTime @default(now())
}

// R49 loyalty program — a rewards member identified by phone number.
// Points: 1 pt per 1 EGP of final total × tier multiplier.
// Tiers (lifetime points): bronze 0, silver 300, gold 1000, platinum 2500.
// Redemption: 100 pts = 25 EGP off, in 100-pt multiples, server-validated.
model LoyaltyMember {
  id             String   @id @default(cuid())
  phone          String   @unique
  name           String
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("bronze") // bronze | silver | gold | platinum
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ledger PointsLedger[]
}

// Audit trail for every points movement (earn / redeem / bonus / adjustment).
model PointsLedger {
  id        String        @id @default(cuid())
  member    LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  orderId   String?
  delta     Int
  reason    String // order_earn | redeem | signup_bonus | adjustment
  createdAt DateTime      @default(now())
}

// R53 web push — a phone/browser subscribed to order-status notifications.
// Subscriptions are keyed by guest name (the same identity guests use for
// check-in/favorites/tracking): when an order's status changes, every
// subscription registered for that guest gets a push from the cloud.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // the push service URL (browser-managed)
  p256dh    String // subscription.keys.p256dh
  auth      String // subscription.keys.auth
  guestName String // guest identity for matching to orders
  platform  String   @default("web") // web | android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A procurement purchase: buying molasses packs or supply boxes to restock.
model Purchase {
  id           String   @id @default(cuid())
  // What was bought: "molasses" (brand pack) or "supply" (coal/foil/hose box)
  kind         String // molasses | supply
  // For molasses: catalog brandId. For supply: supply key (regular_coal, ...).
  refId        String
  name         String // display name, e.g. "Mazaya · 250g pack"
  // Pack details
  gramsOrUnits Float // grams (molasses) or units (supply) per pack
  packCount    Int // how many packs were bought
  unitCost     Float // EGP per pack
  totalCost    Float // EGP total (unitCost * packCount)
  // Optional: who recorded the purchase
  buyerName    String?
  // r57: which branch this purchase restocks
  branchId     String?
  createdAt    DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// r61 — Platform Control Center settings. A tiny key→JSON store the
// platform owner edits from the Settings/Menu tabs of the control center.
// Known keys (see src/lib/platform-settings.ts):
//   "rsm_config"     → { commissionPct, wedjatSharePct }  (defaults 12 / 40)
//   "menu_pricing"   → { [brandId]: { fruits?, fruitsMix?, flat? } }
//   "platform_info"  → { displayName }
model PlatformSetting {
  key       String   @id
  value     String // JSON-serialized payload
  updatedBy String? // employee name of the last editor (audit trail)
  updatedAt DateTime @updatedAt
}

// r69 (audit ⑥) — PIN brute-force guard: failed employee sign-in attempts,
// counted per source IP and per PIN over sliding windows (see
// src/lib/rate-limit.ts). A 4-digit PIN space is only 10,000 codes —
// without this, a scripted client could walk the whole space in minutes.
model PinAttempt {
  id        String   @id @default(cuid())
  pin       String
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([pin, createdAt])
}

// r71 — DB-backed rate limiting for the OPEN guest write endpoints
// (order placement, living-order amendments, ratings, coal/call
// requests). Same cross-instance pattern as PinAttempt: one row per
// allowed attempt, counted over a rolling window, pruned opportunistically.
model GuestAttempt {
  id        String   @id @default(cuid())
  key       String // e.g. "order:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// r69 (audit ⑧) — lightweight error tracking. The client reports uncaught
// errors / unhandled rejections (see src/lib/error-reporter.ts); the
// platform owner reviews them via GET /api/errors?pin=<platform pin>.
// Same-message reports within 5 minutes increment `count` instead of
// stacking duplicate rows.
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  source    String   @default("client") // client | server
  url       String?
  userAgent String?
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([message])
}

// r73 — off-site backup audit log. The Vercel cron (and the owner from the
// Settings tab) snapshots EVERY table, pushes the JSON to the private
// wedjat_mazaj_backups repo (data branch, 30-snapshot retention) and
// records each run here: what was captured, how big, whether the off-site
// copy landed. The run log itself lives in the DB it protects — restoring
// means replaying the latest snapshot file, this table included.
model BackupRun {
  id        String   @id @default(cuid())
  kind      String // cron | manual
  status    String // success | partial | failed
  tables    Int      @default(0)
  rows      Int      @default(0)
  sizeBytes Int      @default(0)
  sha256    String   @default("")
  offsite   Boolean  @default(false) // snapshot landed on the private repo
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
