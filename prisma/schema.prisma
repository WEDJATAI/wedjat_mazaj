// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  pin       String   @unique
  role      String   @default("employee") // super_admin | admin | employee
  // Comma-separated permission keys (see src/lib/permissions.ts).
  // Empty/null => use role defaults.
  permissions String  @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model InventoryItem {
  id                String   @id @default(cuid())
  brandId           String   @unique
  brandName         String
  stockGrams        Float
  lowStockThreshold Float    @default(100)
  updatedAt         DateTime @updatedAt

  flavors FlavorStock[]
}

// Per-flavor stock subtype (exact grams of each flavor within a brand).
model FlavorStock {
  id                String   @id @default(cuid())
  brand             InventoryItem @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String
  brandIdRaw        String   // catalog brandId (e.g. "mazaya") for lookups
  brandName         String
  flavorName        String
  stockGrams        Float
  lowStockThreshold Float    @default(60)
  updatedAt         DateTime @updatedAt

  @@unique([brandIdRaw, flavorName])
}

// Consumable supplies (coal, foil, hose, …). Tracked in their own unit, auto-deducted on order.
model SupplyItem {
  id                String   @id @default(cuid())
  key               String   @unique // regular_coal | cubed_coal | foil | medical_hose | ...
  name              String
  unit              String   // pcs | sheets | ...
  stock             Float
  lowStockThreshold Float    @default(20)
  cost              Float    @default(0) // EGP per unit (business cost)
  sellPrice         Float    @default(0) // EGP charged to client when chosen as add-on
  emoji             String   @default("📦")
  updatedAt         DateTime @updatedAt
}

model ServiceRequest {
  id              String   @id @default(cuid())
  type            String   @default("call_shisha_man") // call_shisha_man | coal_request | ...
  guestName       String?
  table           String?
  note            String?
  status          String   @default("pending") // pending | acknowledged | done
  createdAt       DateTime @default(now())
  acknowledgedAt  DateTime?
}

// A guest's saved favorite mix (their go-to bowl).
model FavoriteMix {
  id          String   @id @default(cuid())
  guestName   String
  label       String
  componentsJson String // serialized FlavorComponent[]
  createdAt   DateTime @default(now())
}

model Order {
  id            String   @id @default(cuid())
  customerName  String?
  phone         String?
  table         String?
  notes         String?
  itemsJson     String
  subtotal      Float
  discount      Float    @default(0)
  total         Float
  bogo          Boolean  @default(false)
  ownType       String?
  itemCount     Int      @default(0)
  status        String   @default("pending") // pending | preparing | done
  source        String   @default("employee") // employee | guest_scan | guest_call
  // R49 loyalty: the member this order earned/redeemed points for, and the
  // discount applied from redeemed points (server-validated, never trusted
  // from the client).
  loyaltyMemberId String?
  pointsEarned    Int      @default(0)
  pointsRedeemed  Int      @default(0)
  loyaltyDiscount Float    @default(0)
  // R49 guest feedback: 1–5 stars + optional comment, submitted by the
  // guest from the live tracking view once the order is done.
  rating          Int?
  ratingComment   String?
  ratedAt         DateTime?
  orderedByName String?
  employeeId    String?
  favoriteMixId String?
  // Order-receiving workflow:
  //  - "unassigned": guest self-order awaiting an employee to confirm
  //  - "assigned":   an employee has claimed/confirmed it (assignedToName set)
  //  - null:        employee-created orders are immediately theirs
  assignment    String?  // unassigned | assigned
  assignedToName String?
  assignedToId   String?
  // Profitability (computed server-side at order time)
  cogs          Float    @default(0) // cost of goods sold (molasses + supplies)
  molassesCost  Float    @default(0)
  suppliesCost  Float    @default(0)
  netProfit     Float    @default(0) // total - cogs
  marginPct     Float    @default(0) // netProfit / total * 100
  // R46: sellable add-ons chosen with the order (JSON string array, e.g.
  // ["medical_hose"]) — needed to re-push the exact check lines on retry.
  addonsJson    String?
  // Wedjat RSM sync tracking
  wedjatOrderId Int?     // the order ID in Wedjat RSM (null = not synced)
  wedjatSyncStatus String @default("pending") // pending | synced | failed | revoked
  wedjatRevokedBy String? // name of the Wedjat employee who revoked it
  wedjatRevokedAt DateTime?
  // R46: the NUMERIC Wedjat RSM table id (table NAMES repeat across the
  // restaurant's floors, so the id is the only unambiguous reference).
  // Captured from the POS "Order Shisha" button URL (?tableId=) or the
  // employee table picker, stored on the order and echoed to the RSM
  // webhook so items land on the RIGHT table's check.
  wedjatTableId Int?
  createdAt     DateTime @default(now())

  comments OrderComment[]
}

model OrderComment {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  author    String
  body      String
  createdAt DateTime @default(now())
}

// R49 loyalty program — a rewards member identified by phone number.
// Points: 1 pt per 1 EGP of final total × tier multiplier.
// Tiers (lifetime points): bronze 0, silver 300, gold 1000, platinum 2500.
// Redemption: 100 pts = 25 EGP off, in 100-pt multiples, server-validated.
model LoyaltyMember {
  id             String   @id @default(cuid())
  phone          String   @unique
  name           String
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("bronze") // bronze | silver | gold | platinum
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ledger PointsLedger[]
}

// Audit trail for every points movement (earn / redeem / bonus / adjustment).
model PointsLedger {
  id        String   @id @default(cuid())
  member    LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  orderId   String?
  delta     Int
  reason    String   // order_earn | redeem | signup_bonus | adjustment
  createdAt DateTime @default(now())
}

// R53 web push — a phone/browser subscribed to order-status notifications.
// Subscriptions are keyed by guest name (the same identity guests use for
// check-in/favorites/tracking): when an order's status changes, every
// subscription registered for that guest gets a push from the cloud.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // the push service URL (browser-managed)
  p256dh    String   // subscription.keys.p256dh
  auth      String   // subscription.keys.auth
  guestName String   // guest identity for matching to orders
  platform  String   @default("web") // web | android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A procurement purchase: buying molasses packs or supply boxes to restock.
model Purchase {
  id          String   @id @default(cuid())
  // What was bought: "molasses" (brand pack) or "supply" (coal/foil/hose box)
  kind        String   // molasses | supply
  // For molasses: catalog brandId. For supply: supply key (regular_coal, ...).
  refId       String
  name        String   // display name, e.g. "Mazaya · 250g pack"
  // Pack details
  gramsOrUnits Float   // grams (molasses) or units (supply) per pack
  packCount   Int      // how many packs were bought
  unitCost    Float    // EGP per pack
  totalCost   Float    // EGP total (unitCost * packCount)
  // Optional: who recorded the purchase
  buyerName   String?
  createdAt   DateTime @default(now())
}
