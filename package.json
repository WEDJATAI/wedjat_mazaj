{
  "name": "wedjat-mazaj",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-local-schema.mjs && prisma generate --schema prisma/schema.local.prisma && DATABASE_URL=\"$( (grep -m1 '^DATABASE_URL=' .env.local 2>/dev/null || grep -m1 '^DATABASE_URL=' .env) | cut -d= -f2- )\" next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "node scripts/gen-local-schema.mjs && prisma db push --schema prisma/schema.local.prisma --accept-data-loss",
    "db:generate": "node scripts/gen-local-schema.mjs && prisma generate --schema prisma/schema.local.prisma",
    "db:migrate": "node scripts/gen-local-schema.mjs && prisma migrate dev --schema prisma/schema.local.prisma",
    "db:reset": "node scripts/gen-local-schema.mjs && prisma migrate reset --schema prisma/schema.local.prisma",
    "db:seed": "bun run prisma/seed.ts",
    "db:push:prod": "prisma db push --schema prisma/schema.prisma --accept-data-loss --skip-generate",
    "db:seed:prod": "prisma generate --schema prisma/schema.prisma && bun run prisma/seed.ts && node scripts/gen-local-schema.mjs && prisma generate --schema prisma/schema.local.prisma",
    "test:e2e": "playwright test",
    "backup": "bash scripts/backup-db.sh",
    "backup:neon": "bun scripts/backup-neon.mjs --dir backups"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "inngest": "^4.22.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}